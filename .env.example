# Copy to .env (git-ignored) and point it at a Microsoft-Decision-1 deployment on Microsoft Foundry.
FOUNDRY_ENDPOINT=https://<foundry-resource>.cognitiveservices.azure.com
FOUNDRY_DEPLOYMENT=decision-1-dz
# Optional key auth. Without it the server signs in with Entra ID through `az login`.
# FOUNDRY_API_KEY=

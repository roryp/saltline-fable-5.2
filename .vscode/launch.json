{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Saltline server",
      "program": "${workspaceFolder}/server.js",
      "env": { "LOG_DECISIONS": "1" },
      "serverReadyAction": {
        "pattern": "running at (http://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
